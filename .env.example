# OkulDesk — Ortam Değişkenleri Örneği
# Bu dosyayı backend/.env olarak kopyalayıp değerleri güncelleyin.
# Tauri (masaüstü) ortamında bu değerler otomatik yönetilir.

# ── Veritabanı ────────────────────────────────────────
# Tauri / geliştirme ortamı (SQLite):
DATABASE_URL=file:./database.db

# Docker deployment ortamı (volume mount ile SQLite):
# DATABASE_URL=file:/app/data/database.db

# ── JWT ───────────────────────────────────────────────
# En az 32 karakter, tercihen 64+ karakter rastgele string
JWT_SECRET=your-very-long-random-jwt-secret-key-at-least-64-chars
JWT_EXPIRES_IN=8h

# ── Yükleme ve Yedekleme ──────────────────────────────
UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ── Sunucu ────────────────────────────────────────────
PORT=4000
NODE_ENV=production
