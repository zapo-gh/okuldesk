{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OkulDesk",
  "version": "1.0.11",
  "identifier": "com.okuldesk.app",
  "build": {
    "frontendDist": "../backend/dist/public",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:all"
  },
  "app": {
    "windows": [
      {
        "title": "OkulDesk - Okul Yönetim Otomasyonu",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:4000 http://127.0.0.1:4000 ws://localhost:4000 ws://127.0.0.1:4000; img-src 'self' data: blob: http://localhost:4000 http://127.0.0.1:4000; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMzODNDOURGODE2QjFGOTgKUldTWUgydUIzOG1ETTlxZ2VNWVVkWThXUEkrUHh0YnBIYWF5VG1GZitUSEhoTUh2T0x5TlI0V2wK",
      "endpoints": [
        "https://github.com/zapo-gh/okuldesk/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "icon": [
      "../assets/icon.png",
      "../assets/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../backend/dist": "backend/dist",
      "../backend/node_modules": "backend/node_modules",
      "../backend/prisma": "backend/prisma"
    }
  }
}
