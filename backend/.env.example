# Environment
NODE_ENV=development
PORT=4000

# Database
# Geliştirme ortamı için (Tauri runtime'da bu otomatik ayarlanır)
DATABASE_URL=file:./devamsizlik.db

# JWT
# Production'da en az 32 karakterlik güçlü, rastgele bir değer kullanın.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Seed credentials (yalnızca prisma:seed çalıştırırken kullanılır)
# Production ortamında bu iki değer zorunludur.
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
SEED_PARENT_PASSWORD=replace-with-a-strong-parent-password

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Upload / backup
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Domain (used in WhatsApp link)
FRONTEND_DOMAIN=https://yourdomain.com

# CORS
CORS_ORIGIN=http://localhost:5173
